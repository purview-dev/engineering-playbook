<Project>
	<!--
		Central Package Management for the Engineering Playbook.
		==================================================================
		`ManagePackageVersionsCentrally` is already set to true by the Purview.BuildSdk import, so
		this file only declares versions. Only packages this repository actually consumes are listed;
		the SDK wires TUnit, TUnit.Core, TUnit.Mocks and Bogus into test projects, so their versions
		must be resolvable here.

		A version that is shared by a family of packages — or that belongs to a product whose packages
		are released together — is declared once as a property and referenced by every `PackageVersion`
		in that family. A package with no family keeps its literal version.

		The playbook ships no NuGet package, so there are no packable projects and no package
		metadata to declare.
	-->
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<!-- Version Definitions -->
	<PropertyGroup Label=".NET Versions">
		<MSExtensionVersion>10.10.0</MSExtensionVersion>
	</PropertyGroup>
	<PropertyGroup Label="Purview Versions">
		<PurviewTelemetryVersion>5.0.3</PurviewTelemetryVersion>
	</PropertyGroup>
	<PropertyGroup Label="Testing Versions">
		<TUnitVersion>1.72.4</TUnitVersion>
	</PropertyGroup>

	<!-- Packages -->
	<ItemGroup Label="Purview">
		<!--
			The SDK injects this itself, so under Central Package Management the version has to be
			declared here or restore fails with NU1010. Telemetry is on by default and can be turned
			off per repository with `ExcludePurviewTelemetry`.
		-->
		<PackageVersion Include="Purview.Telemetry.SourceGenerator" Version="$(PurviewTelemetryVersion)" />
	</ItemGroup>
	<ItemGroup Label="Microsoft Extensions">
		<PackageVersion Include="Microsoft.Extensions.Telemetry.Abstractions" Version="$(MSExtensionVersion)" />
	</ItemGroup>
	<ItemGroup Label="Other">
		<!-- Injected by the SDK and added to every assembly. -->
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
	</ItemGroup>
	<ItemGroup Label="Testing">
		<!-- The test packages the SDK wires into test and shared-testing projects. -->
		<PackageVersion Include="TUnit" Version="$(TUnitVersion)" />
		<PackageVersion Include="TUnit.Core" Version="$(TUnitVersion)" />
		<PackageVersion Include="TUnit.Mocks" Version="$(TUnitVersion)" />
		<PackageVersion Include="Bogus" Version="35.6.5" />
	</ItemGroup>
</Project>
